FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml uv.lock /app/

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev

COPY src/mcp_sentry/__init__.py ./mcp_sentry/__init__.py
COPY src/mcp_sentry/targets/__init__.py ./mcp_sentry/targets/__init__.py
COPY src/mcp_sentry/targets/_fixtures.py ./mcp_sentry/targets/_fixtures.py
COPY src/mcp_sentry/targets/fragile_server.py ./mcp_sentry/targets/fragile_server.py

ENV PATH="/app/.venv/bin:$PATH"

ENTRYPOINT ["python", "-m", "mcp_sentry.targets.fragile_server"]